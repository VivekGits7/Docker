# Dedicated env for the standalone MinIO service. Copy to minio/.env
# These root credentials are the S3 access key and secret key clients use.

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Bucket created automatically on startup.
MINIO_DEFAULT_BUCKET=langfuse

# MinIO's own network, created automatically when this stack starts.
MINIO_NETWORK=minio-network
